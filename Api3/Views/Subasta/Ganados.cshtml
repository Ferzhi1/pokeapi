@model List<api3.Models.ProductoPokemon>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tu Colección Pokémon</title>
    <link rel="stylesheet" href="~/css/styles2.css">
 
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid justify-content-between">
            <ul class="navbar-nav d-flex flex-row">
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/SolicitudAmistad/ListaSolicitudes">👥 Amigos</a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Pokemon/Coleccion">📦 Colección Pokémon</a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Pokemon/Index">🏆 Subastas ganadas</a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Venta/Venta">🏆 Subastas ganadas</a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Venta/Mercado">🌐 Mercado Pokémon</a>
                </li>
           
            </ul>
            <div class="d-flex flex-column align-items-end">
                <span class="text-light">💰 Monedas: <strong>@ViewBag.Monedero</strong></span>
                <span class="text-light">📧 @ViewBag.EmailUsuario</span>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-1">
                    <button type="submit" class="btn btn-link nav-link p-0 text-white">🔓 Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container text-center mt-5">
        <h2 class="mb-4">Pokémon Ganados en Subasta</h2>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <input type="hidden" id="emailUsuario" value="@ViewBag.EmailUsuario" />

            @foreach (var pokemon in Model)
            {
                <div class="pokemon-card" data-id="@pokemon.PokemonIdOriginal" data-enventa="@pokemon.EnVenta.ToString().ToLower()">
                    <div class="card shadow-lg">
                        <div class="d-flex align-items-center p-3">
                            <div class="flex-shrink-0 mx-auto">
                                <img src="@pokemon.ImagenUrl" class="img-fluid rounded pokemon-img" alt="@pokemon.Nombre"
                                     style="width: 180px; height: auto;"
                                     onerror="this.src='/images/default-pokemon.png';" />
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <h5 class="card-title pokemon-nombre">@pokemon.Nombre</h5>
                            <p class="card-text pokemon-rareza">Rareza: <strong>@pokemon.Rareza</strong></p>
                            <div class="stats-section mb-3">
                                <h6>📊 Estadísticas:</h6>
                                <ul class="list-group">
                                    @if (pokemon.Stats?.Any() ?? false)
                                    {
                                        @foreach (var stat in pokemon.Stats)
                                        {
                                            <li class="list-group-item small">@stat.Nombre: <strong>@stat.Valor</strong></li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="list-group-item small text-muted">Sin estadísticas.</li>
                                    }
                                </ul>
                            </div>
                            <button class="btn btn-danger mt-2 guardar-btn">Guardar</button>
                     
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script src="~/js/ganados.js"></script>
</body>
</html>

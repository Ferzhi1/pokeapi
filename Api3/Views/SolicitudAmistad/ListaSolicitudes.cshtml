@model List<api3.Models.SolicitudAmistad>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitudes de Amistad</title>
    <link rel="stylesheet" href="~/css/amistad.css">
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid justify-content-between">
            <ul class="navbar-nav d-flex flex-row">
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Pokemon/Index">📔 Mazos</a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Pokemon/Coleccion">📦 Colección Pokémon</a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Subasta/Ganados">🏆 Subastas ganadas</a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Venta/Venta">🛒 Venta</a>
                </li>
                <li class="nav-item me-3">
                    <a class="nav-link text-white" href="/Venta/Mercado">🌐 Mercado Pokémon</a>
                </li>
            </ul>
            <div class="d-flex flex-column align-items-end">
                <span class="text-light">💰 Monedas: <strong>@ViewBag.Monedero</strong></span>
                <span class="text-light">📧 @ViewBag.EmailUsuario</span>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-1">
                    <button type="submit" class="btn btn-link nav-link p-0 text-white">🔓 Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container text-center mt-5">
        <h2 class="mb-4">📩 Amigos</h2>

        <p>Email del usuario: <strong>@ViewBag.EmailUsuario</strong></p>
        <input type="hidden" id="emailUsuario" value="@ViewBag.EmailUsuario" />

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (Model != null && Model.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Amigo</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var solicitud in Model)
                    {
                        <tr id="solicitud-@solicitud.Id">
                            <td>@solicitud.RemitenteEmail</td>
                            <td>@solicitud.FechaEnvio.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="text-center mt-4">
                <a href="/" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm text-decoration-none">
                    🏠 Volver al inicio
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-4">
                ⚠ No hay solicitudes de amistad pendientes en este momento.
            </div>
        }
    </div>

</body>
</html>

@model List<api3.Models.SolicitudAmistad>

<div class="container text-center mt-5">
    <h2 class="mb-4">📩 Amigos</h2>

    <p>Email del usuario: <strong>@ViewBag.EmailUsuario</strong></p>
    <input type="hidden" id="emailUsuario" value="@ViewBag.EmailUsuario" />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Amigo</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitud in Model)
                {
                    <tr id="solicitud-@solicitud.Id">
                        <td>@solicitud.RemitenteEmail</td>
                        <td>@solicitud.FechaEnvio.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="text-center mt-4">
            <a href="/" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm text-decoration-none">
                🏠 Volver al inicio
            </a>
        </div>


    }
 
</div>

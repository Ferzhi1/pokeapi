@using api3.Models
@model List<MazoPokemon>

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Tienda Pokémon</title>
	<link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
	<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
		<div class="container-fluid justify-content-between">
			<ul class="navbar-nav d-flex flex-row">
				<li class="nav-item me-3">
					<a class="nav-link text-white" href="/SolicitudAmistad/ListaSolicitudes">👥 Amigos</a>
				</li>
				<li class="nav-item me-3">
					<a class="nav-link text-white" href="/Venta/Venta">🛒 Ir a venta</a>
				</li>
				<li class="nav-item me-3">
					<a class="nav-link text-white" href="/Subasta/Ganados">🏆 Subastas ganadas</a>
				</li>
				<li class="nav-item me-3">
					<a class="nav-link text-white" href="/Venta/Mercado">🌐 Mercado Pokémon</a>
				</li>
				<li class="nav-item me-3">
					<a class="nav-link text-white" href="/Pokemon/Coleccion">🧾 Coleccion</a>
				</li>
			</ul>
			<div class="d-flex flex-column align-items-end">
				<span class="text-light">💰 Monedas: <strong>@ViewBag.Monedero</strong></span>
				<span class="text-light">📧 @ViewBag.EmailUsuario</span>
				<form asp-controller="Auth" asp-action="Logout" method="post" class="mt-1">
					<button type="submit" class="btn btn-link nav-link p-0 text-white">🔓 Cerrar sesión</button>
				</form>
			</div>
		</div>
	</nav>





	<header class="hero">
		<h1>Tienda de Mazos Pokémon</h1>
		<p>Explora la colección y potencia tu juego</p>
	</header>

	<section class="hero-carrusel">
		<div class="slides">
			<img src="/img/4124520.jpg" alt="Hero 1" class="slide active">
			<img src="/img/487115 (1).jpg" alt="Hero 2" class="slide">
			<img src="/img/487192 (1).jpg" alt="Hero 3" class="slide">
		</div>
	</section>



	<section class="presentacion-cartas">
		<div class="imagen-cartas">
			<img src="/img/4124520.jpg" alt="Carta Pokémon" />
		</div>

		<div class="texto-cartas">
			<h2>Cartas Pokémon</h2>
			<p>
				¡Descubre el poder de los mazos Pokémon y prepárate para la batalla definitiva! Sumérgete en el universo Pokémon como nunca antes con nuestra exclusiva colección de mazos cuidadosamente seleccionados. Cada uno está diseñado para ofrecer una experiencia única, llena de estrategia, sorpresas y combates épicos.

				Ya seas un entrenador principiante o un coleccionista experimentado, encontrarás un mazo que se adapta perfectamente a tu estilo de juego y a tus Pokémon favoritos. Los mazos que ofrecemos están listos para jugar desde el primer momento. Incluyen cartas clave con sinergias poderosas, entrenadores estratégicos y energías esenciales para enfrentarte a cualquier desafío.

				Además, todos nuestros productos son 100% auténticos y vienen sellados directamente de fábrica para garantizar su calidad y valor coleccionable. Haz crecer tu arsenal, fortalece tu estrategia y conviértete en el entrenador que siempre soñaste ser.
			</p>
		</div>
	</section>


	<main class="fila-mazos">
		@foreach (var mazo in Model.Take(3))
		{
			<div class="mazo-card">
				<img src="@mazo.ImagenUrl" alt="@mazo.Nombre" />
				<h3>@mazo.Nombre</h3>
				<p>$@mazo.Precio</p>
				<a asp-controller="Pedido" asp-action="Checkout" asp-route-nombre="@mazo.Nombre">Comprar</a>
			</div>
		}
	</main>
	<script>
		let currentSlide = 0;
		const slides = document.querySelectorAll(".slide");

		setInterval(() => {
			slides[currentSlide].classList.remove("active");
			currentSlide = (currentSlide + 1) % slides.length;
			slides[currentSlide].classList.add("active");
		}, 4000);
	</script>


</body>
</html>

@model List<api3.Models.ColeccionPokemon>
@{
    int currentPage = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string email = ViewBag.EmailUsuario ?? "Entrenador desconocido";
    int monedero = ViewBag.Monedero ?? 0;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>Pokédex - Álbum</title>
    <link rel="stylesheet" href="~/css/stylecoleccion.css" />
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid justify-content-between">
            <a class="navbar-brand" href="#">Pokémon Store</a>
            <div class="d-flex flex-column align-items-end">
                <span class="text-light">💰 Monedas: <strong>@ViewBag.Monedero</strong></span>
                <span class="text-light">📧 @ViewBag.EmailUsuario</span>
            </div>
        </div>
    </nav>


    <div class="container pokedex-container">
        <h2>📘 Álbum de colección</h2>

        <div class="pokedex-grid">
            @foreach (var pokemon in Model)
            {
                <div class="pokedex-card @(string.IsNullOrEmpty(pokemon.Nombre) ? "empty" : "filled")">
                    <div class="card">
                        <div class="d-flex align-items-center p-3">
                            <div class="flex-shrink-0">
                                @if (!string.IsNullOrEmpty(pokemon.Nombre))
                                {
                                    <img src="@pokemon.ImagenUrl" class="img-fluid rounded pokemon-img"
                                         onerror="this.src='/images/default-pokemon.png';" />
                                }
                                else
                                {
                                    <img src="/images/silueta.png" class="img-fluid rounded pokemon-img" />
                                }
                            </div>
                            <div class="stats-section ms-3">
                                <h6>N.º @pokemon.PokemonIdOriginal.ToString("D3")</h6>
                                @if (!string.IsNullOrEmpty(pokemon.Nombre))
                                {
                                    <h5 class="pokemon-nombre">@pokemon.Nombre</h5>
                                    <ul class="list-group">
                                        @if (pokemon.Stats?.Any() ?? false)
                                        {
                                            @foreach (var stat in pokemon.Stats)
                                            {
                                                <li class="list-group-item small">@stat.Nombre: <strong>@stat.Valor</strong></li>
                                            }
                                        }
                                        else
                                        {
                                            <li class="list-group-item small text-muted">Sin estadísticas</li>
                                        }
                                    </ul>
                                    <p class="pokemon-rareza mt-2">Rareza: <strong>@pokemon.Rareza</strong></p>
                                }
                                else
                                {
                                    <h6 class="text-muted mt-3">Aún no lo obtienes</h6>
                                    <p class="text-muted">Captúralo para ver sus estadísticas</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="pagination">
            @if (currentPage > 1)
            {
                <a href="@Url.Action("Coleccion", new { page = currentPage - 1 })" class="pagination-btn">⬅ Anterior</a>
            }

            <span class="page-indicator">Página @currentPage de @totalPages</span>

            @if (currentPage < totalPages)
            {
                <a href="@Url.Action("Coleccion", new { page = currentPage + 1 })" class="pagination-btn">Siguiente ➡</a>
            }
        </div>
    </div>

</body>
</html>
